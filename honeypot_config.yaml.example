# Honeypot Configuration File
# Copy this file to honeypot_config.yaml and edit to configure your honeypot settings

general:
  honeypot_name: corporate-server-01  # Unique identifier for this honeypot
  log_level: INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Kafka configuration for event streaming
kafka:
  enabled: false  # Set to true to enable Kafka reporting
  bootstrap_servers:
    - localhost:9092
    # - kafka1.example.com:9092
    # - kafka2.example.com:9092
  topic: honey

  # Optional: SSL/SASL configuration
  ssl_enabled: false
  sasl_mechanism: null  # Options: PLAIN, SCRAM-SHA-256, SCRAM-SHA-512
  sasl_username: null
  sasl_password: null

# Webhook configuration for event reporting
webhook:
  enabled: false  # Set to true to enable webhook reporting
  url: http://localhost:8080/webhook  # Your webhook endpoint
  timeout: 5  # Request timeout in seconds
  retry_attempts: 3  # Number of retry attempts on failure

  # Optional: Custom headers for authentication
  headers:
    Content-Type: application/json
    X-API-Key: your-api-key-here
    # Authorization: Bearer your-token-here

# Service configurations
services:
  # SMB/File Server Honeypot
  smb:
    enabled: true
    port: 4445  # Use 445 for production (requires root), 4445 for testing
    banner: Windows Server 2019
    fake_shares:
      - Documents
      - Shared
      - Backups
      - Finance
      - HR
      - IT
      - Legal

  # HTTP/Web Server Honeypot
  http:
    enabled: true
    port: 8000  # Use 80 for production (requires root), 8000 for testing
    server_header: Apache/2.4.41 (Ubuntu)
    fake_hostname: intranet.company.local

  # LDAP Directory Service Honeypot
  ldap:
    enabled: true
    port: 3389  # Use 389 for production (requires root), 3389 for testing
    base_dn: DC=company,DC=com
    fake_users:
      - CN=John Doe,OU=Users,DC=company,DC=com
      - CN=Jane Smith,OU=Users,DC=company,DC=com
      - CN=Bob Johnson,OU=Users,DC=company,DC=com
      - CN=Admin,OU=Admins,DC=company,DC=com
      - CN=Service Account,OU=Service,DC=company,DC=com
      - CN=Database Admin,OU=Admins,DC=company,DC=com

  # SSH Server Honeypot (NEW)
  ssh:
    enabled: true
    port: 2222  # Use 22 for production (requires root), 2222 for testing
    banner: SSH-2.0-OpenSSH_7.4
    host_key_path: ./data/ssh_host_key
    fake_users:
      - root
      - admin
      - ubuntu
      - user
      - pi
      - guest
    password_attempts_before_disconnect: 3

# Alerting configuration
alerting:
  alert_on_connection: false  # Alert on every connection (can be noisy)
  alert_on_auth_attempt: true  # Alert on authentication attempts
  alert_on_suspicious_patterns: true  # Alert on known attack patterns

  # Paths that trigger high-severity alerts
  suspicious_paths:
    - /admin
    - /phpmyadmin
    - /.git
    - /.env
    - /wp-admin
    - /wp-login.php
    - /files/passwords
    - /files/database
    - /files/config
    - /.aws
    - /.ssh
    - /backup
    - /db
    - /sql
    - /config

  # Severity levels for different event types
  severity_thresholds:
    connection: low
    auth_attempt: high
    data_exfiltration: critical
    suspicious_access: high

# Rate limiting configuration
rate_limiting:
  enabled: true
  max_connections_per_ip: 100  # Maximum connections per IP
  time_window_seconds: 3600  # Time window in seconds (1 hour)

# Database persistence (NEW)
database:
  enabled: true  # Enable local event storage
  type: sqlite  # Options: sqlite, postgresql

  # SQLite configuration (simple, single-file database)
  sqlite_path: ./data/honeypot_events.db

  # PostgreSQL configuration (production)
  postgresql:
    host: localhost
    port: 5432
    database: honeypot
    username: honeypot_user
    password: CHANGE_ME_SECURE_PASSWORD
    pool_size: 5

  # Retention policy
  retention_days: 90  # Delete events older than N days (0 = keep forever)
  cleanup_interval_hours: 24  # Run cleanup every N hours

# Splunk HEC integration (NEW)
splunk:
  enabled: false  # Enable Splunk HTTP Event Collector
  hec_url: https://splunk.company.com:8088/services/collector
  hec_token: YOUR-SPLUNK-HEC-TOKEN
  index: honeypot_events
  source: honeypot
  sourcetype: honeypot:json
  verify_ssl: true
  batch_size: 10  # Batch events before sending
  flush_interval: 5  # Flush batch every N seconds

# Elasticsearch integration (NEW)
elasticsearch:
  enabled: false  # Enable Elasticsearch indexing
  hosts:
    - http://localhost:9200
    # - https://es1.company.com:9200
    # - https://es2.company.com:9200
  username: null  # Optional authentication
  password: null
  index_prefix: honeypot-events  # Creates indices like honeypot-events-2026.02.25
  use_ssl: false
  verify_certs: true
  ca_certs: null  # Path to CA certificate bundle
  timeout: 30
  max_retries: 3
  bulk_size: 100  # Bulk index N events at a time

# Threat intelligence enrichment (NEW)
enrichment:
  enabled: true  # Enable IP enrichment

  # MaxMind GeoIP2 (offline, no API limits)
  geoip:
    enabled: false  # Disabled for testing (no database files yet)
    database_path: /var/lib/GeoIP/GeoLite2-City.mmdb
    asn_database_path: /var/lib/GeoIP/GeoLite2-ASN.mmdb
    # Download databases: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data

  # AbuseIPDB (online API, requires free account)
  abuseipdb:
    enabled: false  # Set to true to enable
    api_key: YOUR_ABUSEIPDB_API_KEY
    confidence_threshold: 75  # Alert if abuse score > threshold
    cache_ttl: 86400  # Cache results for 24 hours
    max_requests_per_day: 1000  # Free tier limit

  # Cache configuration
  cache:
    type: memory  # Options: memory, redis
    ttl: 86400  # Cache TTL in seconds (24 hours)
    max_size: 10000  # Maximum cache entries
    redis_url: redis://localhost:6379/0  # If using Redis

# MCP Server for AI integration (NEW)
mcp:
  enabled: false  # Enable Model Context Protocol server
  transport: stdio  # Options: stdio, websocket
  websocket_host: 0.0.0.0  # If using websocket transport
  websocket_port: 8765
  api_key: CHANGE_ME_MCP_API_KEY  # For authentication
  allowed_tools:
    - query_recent_events
    - query_by_ip
    - get_attack_statistics
    - search_events
    - get_threat_intelligence
    - get_top_attackers
  max_results: 100  # Maximum results per query
